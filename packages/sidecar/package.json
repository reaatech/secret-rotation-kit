{
  "name": "@reaatech/secret-rotation-sidecar",
  "version": "1.0.0",
  "description": "HTTP sidecar server for Secret Rotation Kit",
  "license": "MIT",
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reaatech/secret-rotation-kit.git",
    "directory": "packages/sidecar"
  },
  "homepage": "https://github.com/reaatech/secret-rotation-kit/tree/main/packages/sidecar#readme",
  "bugs": {
    "url": "https://github.com/reaatech/secret-rotation-kit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "secret-rotation-sidecar": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@reaatech/secret-rotation-core": "workspace:*",
    "@reaatech/secret-rotation-observability": "workspace:*",
    "@reaatech/secret-rotation-types": "workspace:*"
  },
  "peerDependencies": {
    "@reaatech/secret-rotation-provider-aws": "workspace:^",
    "@reaatech/secret-rotation-provider-gcp": "workspace:^",
    "@reaatech/secret-rotation-provider-vault": "workspace:^",
    "@reaatech/secret-rotation-provider-vercel": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@reaatech/secret-rotation-provider-aws": {
      "optional": true
    },
    "@reaatech/secret-rotation-provider-gcp": {
      "optional": true
    },
    "@reaatech/secret-rotation-provider-vault": {
      "optional": true
    },
    "@reaatech/secret-rotation-provider-vercel": {
      "optional": true
    }
  },
  "devDependencies": {
    "@reaatech/secret-rotation-provider-aws": "workspace:*",
    "@reaatech/secret-rotation-provider-gcp": "workspace:*",
    "@reaatech/secret-rotation-provider-vault": "workspace:*",
    "@reaatech/secret-rotation-provider-vercel": "workspace:*",
    "@types/node": "^26.0.0",
    "tsup": "^8.4.0",
    "typescript": "^6.0.3",
    "vitest": "^3.1.1"
  }
}
